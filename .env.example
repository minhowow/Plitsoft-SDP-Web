# 환경 변수 목록. 값은 비워 둔다(비밀값을 이 파일에 적지 않는다). 로컬 개발은 이 파일을 .env.local 로 베껴 채운다.
# 기본값과 뜻: docs/direction.md 의 "기본 제한 값", 배포: docs/deploy.md.

# 저장소 구현. synthetic 이면 합성 예시 미리보기(DB·GitHub 을 부르지 않는다). 비우면 DB + GitHub.
SERVICE_STORE=

# DB. 운영은 Postgres 주소(비밀값). 비우면 PGlite(PGLITE_DIR, 기본 .data/pglite).
DATABASE_URL=
PGLITE_DIR=

# GitHub API. 개발에서는 가짜 GitHub(npm run github-stub 의 주소)을 넣는다. 비우면 https://api.github.com.
GITHUB_API_BASE=
# 검색·저장소 정보용 토큰(비밀값, 권한 없는 읽기 토큰). 비우면 토큰 없이 부른다.
GITHUB_TOKEN=

# 실행기. github | local | none (비우면 none: 요청을 받지 않는다).
RUNNER=
# RUNNER=github: 실행기 저장소(owner/repo), 워크플로 파일, 가지, workflow_dispatch 를 부를 토큰(비밀값).
RUNNER_REPO=
RUNNER_WORKFLOW=
RUNNER_REF=
RUNNER_TOKEN=
# 실행기 콜백의 서명 열쇠(비밀값). 실행기(Actions secret, 로컬 실행기)와 같은 값. 비우면 콜백을 모두 거절한다.
RUNNER_SECRET=
# 실행기가 진행·결과를 알릴 이 사이트의 주소(예: https://<프로젝트>.vercel.app).
SITE_URL=
# on 이면 실행기가 policypack review 도 돌린다(모델 호출, 비용이 든다). 비우면 끔. 같은 커밋은 저장된 review 를 다시 쓴다.
REVIEW=

# 상한(비우면 기본값).
MAX_REPO_KB=
DEDUPE_MINUTES=
DAILY_LIMIT=
# 실행 자리 수(동시에 도는 분석 수). 넘는 요청은 대기열에 둔다. 비우면 옛 이름 CONCURRENT_LIMIT 을 읽고, 그것도 없으면 2.
# 로컬 실행기(npm run local-runner)를 따로 띄우면 --parallel 에 같은 값을 준다(npm run local 은 알아서 맞춘다).
POOL_SIZE=
# 대기열 길이 상한(넘으면 그때만 요청을 받지 않는다).
QUEUE_LIMIT=
# 실행기에 보낸 때부터 세는 실행 시간 상한, 보낸 뒤 시작을 알리기까지의 상한, 대기열에서 기다리는 상한(분).
RUN_TIMEOUT_MINUTES=
DISPATCH_TIMEOUT_MINUTES=
QUEUE_TIMEOUT_MINUTES=
SEARCH_CACHE_SECONDS=
# 자동 완성(GET /api/repos/suggest/)의 GitHub 검색 결과를 두는 시간(초). 비우면 600.
SUGGEST_CACHE_SECONDS=
REPO_CACHE_SECONDS=
COMMIT_CACHE_SECONDS=
# 이 사이트가 1분에 GitHub 을 부르는 수(검색, 그 밖). 서버 인스턴스가 DB 의 카운터를 함께 쓴다. 요청한 사람을 가리지 않는다.
# 검색은 검색 쪽과 자동 완성이 함께 쓴다. 비우면 GITHUB_TOKEN 이 있을 때 25, 없을 때 10.
GITHUB_SEARCH_PER_MINUTE=
# 그 가운데 검색 쪽(/search) 몫. 자동 완성은 이만큼 남기고 쓴다. 비우면 3. 상한보다 작게 읽는다.
GITHUB_SEARCH_RESERVE=
GITHUB_CALLS_PER_MINUTE=
RESULT_MAX_KB=

# 시험 전용: 비어 있는 시험용 Postgres(표를 지우고 쓴다). 있으면 tests/server-db-pg.test.ts 가 여러 연결의 동시 요청을 본다.
# 운영 DB 를 넣지 않는다.
TEST_DATABASE_URL=
