{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.cli-0.3.schema.json",
  "title": "policypack scan --output-format json (CLI 0.3: 판 번호 없는 출력과 결과 판 1)",
  "description": "CLI 가 지금 내는 모양을 관찰해 적은 것이다. CLI 저장소의 공식 스키마가 아니다(CLI 는 결과 JSON 의 스키마 파일을 아직 내지 않는다). 웹이 읽는 필드만 required 로 두고 나머지는 허용한다. 판 번호(schema_version)가 없는 출력(CLI 8ae72d8 까지)과 schema_version 1 인 출력(CLI e1e46a9 부터. 실행기가 설치하는 7300205 도 같다)을 함께 받는다. 결과 판 1 은 판 번호 없는 출력에 키를 더한 것이다. 다만 판 1 안에서 판 번호를 그대로 둔 채 뜻이 넓어진 것이 하나 있다: CLI bb76618(e1e46a9 뒤, 7300205 의 조상)부터 run.incomplete 와 untested_reasons 의 engine-incomplete 에 함수 단위 규칙에 쓸 함수 경계를 얻지 못한 파일도 든다. contract/cli-current/ 의 수집본이 이 스키마를 통과해야 한다. 'report/1-draft' 는 웹이 만든 v1 초안 예시의 판이고 이 스키마가 아니다(report.v1-draft.schema.json).",
  "type": "object",
  "required": [
    "tool",
    "run",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "CLI 결과의 판(정수). 없으면 판 번호 없는 출력이다. CLI 는 있던 키가 없어지거나 뜻이 바뀌면 올린다. 웹은 모르는 판을 거부한다."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "judge",
        "pack_digest",
        "ai_pending",
        "engine",
        "units",
        "unparsed",
        "skipped",
        "incomplete",
        "engine_errors",
        "coverage_complete"
      ],
      "properties": {
        "judge": {
          "type": [
            "string",
            "null"
          ],
          "description": "판정자 id. 꺼져 있으면 null."
        },
        "pack_digest": {
          "type": "string",
          "description": "pack.yaml sha256 앞 16자."
        },
        "fingerprint_version": {
          "type": "string",
          "description": "결과 판 1 부터. findings[].fingerprint 를 만드는 방식의 이름(예: policypack/v1). 방식을 바꾸면 이 값이 바뀐다."
        },
        "questions_asked": {
          "type": "integer"
        },
        "ai_answered": {
          "type": "integer"
        },
        "questions_sent": {
          "type": "integer"
        },
        "questions_skipped": {
          "type": "integer",
          "description": "결과 판 1 부터. 판정자가 연달아 시간 안에 답하지 않아 보내지 않은 서로 다른 질문 수(questions_sent 와 같은 기준)."
        },
        "ai_pending": {
          "type": "integer",
          "description": "AI 에게 물어야 했는데 답을 받지 못한 판정 단위 수."
        },
        "ai_cleared": {
          "type": "array",
          "description": "AI 의 '예'로 풀린 경고. 판정자를 켠 결과에만 채워진다. cite 는 AI 가 인용한 코드 줄이다.",
          "items": {
            "type": "object",
            "required": [
              "policy",
              "rule",
              "file",
              "alternatives"
            ],
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "cite": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "gate": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "ai_dismissed": {
          "type": "array",
          "description": "적용 질문에 AI 가 '아니오'라고 답해 빠진 판정. 판정자를 켠 결과에만 채워진다.",
          "items": {
            "type": "object",
            "required": [
              "policy",
              "rule",
              "file"
            ],
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            }
          }
        },
        "static_cleared": {
          "type": "array",
          "description": "결과 판 1 부터. 강한 정적 대안으로 풀린 판정 단위와 그 대안이 맞은 줄 번호. 판정자와 상관없이 실린다. 코드는 싣지 않는다. line 은 그 단위의 줄(발견의 line 과 같은 기준)이다.",
          "items": {
            "type": "object",
            "required": [
              "policy",
              "rule",
              "file",
              "line",
              "alternatives"
            ],
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "lines"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "engine": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "static_seconds": {
          "type": "number"
        },
        "ai_seconds": {
          "type": "number"
        },
        "units": {
          "type": "integer",
          "description": "판정 단위 수. 규칙의 적용 조건이 참이거나 모름인 곳마다 하나다. 충족 판정도 여기에는 들어간다. AI 가 적용되지 않는다고 답해 빠진 판정(ai_dismissed)은 들어가지 않는다."
        },
        "files": {
          "type": "integer",
          "description": "검사한 파일 수."
        },
        "finding_counts": {
          "type": "object",
          "description": "발견을 파일 역할로 나눈 수(CLI 54e048a 부터). service 는 server·screen·other, non_service 는 test·config. 웹은 발견마다의 role 로 센다."
        },
        "unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_errors": {
          "type": "array"
        },
        "coverage_complete": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "policy",
        "rule",
        "outcome",
        "file",
        "line",
        "title",
        "law",
        "ask_developer",
        "untested_reasons",
        "ai_pending",
        "fingerprint",
        "scope",
        "region",
        "unsatisfied_alternatives",
        "decision_path"
      ],
      "properties": {
        "policy": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "needs-review",
            "needs-review-uncertain"
          ]
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "case": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "law": {
          "type": "string"
        },
        "ask_developer": {
          "type": "string"
        },
        "untested_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "parse-error",
              "engine-incomplete",
              "no-judge",
              "judge-unavailable",
              "judge-unparseable",
              "citation-rejected",
              "weak-unconfirmed",
              "timeout"
            ]
          }
        },
        "ai_pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "scope": {
          "enum": [
            "file",
            "anchor"
          ]
        },
        "region": {
          "description": "함수 단위 규칙의 판정 구역(감싸는 가장 바깥 함수의 줄 범위). 파일 단위 규칙에서는 null 이다.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "start_line",
                "end_line"
              ],
              "properties": {
                "start_line": {
                  "type": "integer"
                },
                "end_line": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "role": {
          "enum": ["test", "config", "server", "screen", "other"],
          "description": "이 발견이 나온 파일의 역할(CLI 54e048a 부터). test 는 시험·픽스처·목업·스토리, config 는 설정 파일이고 둘은 서비스 코드가 아니다. CLI 가 경로와 내용의 모양으로 고른 힌트다. 판정은 역할을 보지 않는다. 웹은 서비스 코드가 아닌 파일의 발견을 '사람이 볼 곳' 수에서 빼고 따로 접어 보인다. 없으면(옛 출력, SARIF) 짐작하지 않고 서비스 코드로 센다."
        },
        "top_level": {
          "type": "boolean",
          "description": "함수 단위 규칙(scope: anchor)에서 판정 구역이 함수 밖(모듈 최상위)의 줄인지. 그때 region 은 null 이다. region 이 null 이고 이 값이 false 면 파일 전체를 본 판정이다. CLI 0.3 은 늘 싣는다. 없으면 웹은 판정 구역을 '알 수 없음'으로 보인다."
        },
        "anchor_lines": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "unsatisfied_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "message",
              "ask_developer",
              "remediation",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ask_developer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remediation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "decision_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
